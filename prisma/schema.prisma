// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empleado {
  idEmpleado                      Int                         @id @default(autoincrement()) @map("id_empleado")
  nombres                         String
  apellidos                       String
  /// DNI | CE | PASAPORTE. Con `documento`, único por empresa (validado en
  /// el servicio: el índice único espera a que se limpien los duplicados).
  tipoDocumento                   String                      @default("DNI") @map("tipo_documento")
  documento                       String?
  sede                            String?
  tiempoEmpresaValor              Int?                        @map("tiempo_empresa_valor")
  tiempoEmpresaUnidad             String?                     @default("DIAS") @map("tiempo_empresa_unidad")
  /// Fecha en que ingresó a la empresa: la antigüedad se calcula al día con
  /// ella. Reemplaza a `tiempoEmpresaValor/Unidad` ("3 años" escrito una vez
  /// quedaba desactualizado); esas dos columnas se conservan solo como el
  /// dato original y ya no se escriben (`20261122090000_fecha_ingreso`).
  fechaIngreso                    DateTime?                   @map("fecha_ingreso") @db.Date
  /// Único POR EMPRESA (@@unique abajo), no en todo el sistema: dos empresas
  /// pueden usar el mismo código interno. Es el vínculo con el jefe
  /// (`codigoEmpleadoJefe`): toda búsqueda por código filtra la empresa.
  codigoEmpleado                  String                      @map("codigo_empleado")
  codigoEmpleadoJefe              String?                     @map("codigo_empleado_jefe")
  idEmpresaEmpleadora             Int                         @map("id_empresa_empleadora")
  empresaEmpleadora               EmpresaEmpleadora           @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  idAreaEmpleadora                Int                         @map("id_equipo_empleadora")
  areaEmpleadora                  AreaEmpleadora              @relation(fields: [idAreaEmpleadora], references: [idAreaEmpleadora])
  idPuestoEmpleadora              Int                         @map("id_puesto_empleadora")
  puestoEmpleadora                PuestoEmpleadora            @relation(fields: [idPuestoEmpleadora], references: [idPuestoEmpleadora])
  idGerenciaEmpleadora            Int                         @map("id_unidad_empleadora")
  gerenciaEmpleadora              GerenciaEmpleadora          @relation(fields: [idGerenciaEmpleadora], references: [idGerenciaEmpleadora])
  idUnidadOcupacionalEmpleadora   Int                         @map("id_unidad_ocupacional_empleadora")
  unidadOcupacionalEmpleadora     UnidadOcupacionalEmpleadora @relation(fields: [idUnidadOcupacionalEmpleadora], references: [idUnidadOcupacionalEmpleadora])
  idUsuario                       Int                         @unique @map("id_usuario") // relación 1:1 UNO a UNO
  usuario                         Usuario                     @relation(fields: [idUsuario], references: [idUsuario])
  /// ACTIVO | SUSPENDIDO | CESADO. `estado` sigue siendo "opera o no"
  /// (entra, se evalúa, puede ser jefe) y vale true solo en ACTIVO.
  situacion                       String                      @default("ACTIVO")
  fechaSituacion                  DateTime?                   @map("fecha_situacion")
  motivoSituacion                 String?                     @map("motivo_situacion")
  estado                          Boolean                     @default(true)
  creadoPorId                     Int                         @map("creado_por_id")
  actualizadoPorId                Int?                        @map("actualizado_por_id")
  fechaCreacion                   DateTime                    @default(now()) @map("fecha_creacion")
  fechaModificacion               DateTime?                   @map("fecha_modificacion")
  objetivos                       Objetivo[]
  evaluacionCompetenciasEvaluador EvaluacionCompetencia[]     @relation("evaluador")
  evaluacionCompetenciasEvaluado  EvaluacionCompetencia[]     @relation("evaluado")
  evidencias                      Evidencia[]
  ajustesCalibracion              AjusteCalibracion[]
  sesionesRetroalimentacion       SesionRetroalimentacion[]     @relation("retroEvaluado")
  sesionesRetroComoJefe           SesionRetroalimentacion[]     @relation("retroJefe")

  @@unique([idEmpresaEmpleadora, codigoEmpleado])
  @@index([idEmpresaEmpleadora, tipoDocumento, documento])
  @@index([idEmpresaEmpleadora, situacion])
  @@map("empleado")
}

model Usuario {
  idUsuario           Int                @id @default(autoincrement()) @map("id_usuario")
  /// Único dentro de su ámbito (`idEmpresaCuenta`): por empresa para las
  /// cuentas de trabajadores, en todo el sistema para las demás.
  codigoUsuario       String             @map("codigo_usuario")
  /// Empresa dueña de la cuenta, SOLO para trabajadores (JEFE / EMPLEADO): su
  /// usuario es único dentro de esa empresa, así una persona puede tener
  /// cuenta en varias empresas con el mismo DNI. `null` = cuenta del sistema
  /// (dueño, equipo de TeamWork, RR. HH.): única en todo el sistema. Esa
  /// unicidad la comprueba el servicio: en Postgres los NULL no chocan en un
  /// índice único (`20261122110000_usuario_por_empresa`).
  idEmpresaCuenta     Int?               @map("id_empresa_cuenta")
  /// Nivel de acceso de las cuentas de gestión (EQUIPO y ADMIN_EMPRESA):
  /// `true` = Solo lectura (ve y descarga; no crea, edita, cierra ni elimina),
  /// `false` = Edición. El bloqueo lo hace `RolesGuard` para toda escritura
  /// salvo cambiar la propia contraseña (`20261122120000_solo_lectura`).
  soloLectura         Boolean            @default(false) @map("solo_lectura")
  contrasena          String
  rol                 String             @default("EMPLEADO")
  /// Administrador de empresa (ADMIN_EMPRESA): la persona de RR. HH. que usa
  /// la cuenta y la empresa que administra. No es un trabajador evaluado, por
  /// eso no tiene Empleado. Para JEFE/EMPLEADO la empresa sale de su Empleado
  /// y para ADMIN (TeamWork) no hay empresa: administra todas.
  /// EQUIPO (personal de TeamWork): las empresas de `empresasAsignadas`, o
  /// todas si `todasLasEmpresas`.
  nombreCompleto      String?            @map("nombre_completo")
  todasLasEmpresas    Boolean            @default(false) @map("todas_las_empresas")
  empresasAsignadas   UsuarioEmpresa[]
  idEmpresaEmpleadora Int?               @map("id_empresa_empleadora")
  empresaEmpleadora   EmpresaEmpleadora? @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado              Boolean            @default(true)
  creadoPorId         Int?               @map("creado_por_id")
  actualizadoPorId    Int?               @map("actualizado_por_id")
  fechaCreacion       DateTime           @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?          @map("fecha_modificacion")
  empleado            Empleado?

  @@unique([idEmpresaCuenta, codigoUsuario])
  @@index([idEmpresaEmpleadora])
  @@index([codigoUsuario])
  @@map("usuario")
}

model EmpresaEmpleadora {
  idEmpresaEmpleadora                        Int                           @id @default(autoincrement()) @map("id_empresa_empleadora")
  nombreEmpresa                              String                        @map("nombre_empresa")
  ruc                                        String?                       @unique
  direccionEmpresa                           String?                       @map("direccion_empresa")
  urlLogo                                    String                        @map("url_logo")
  logoPublicId                               String?                       @map("logo_public_id") // Para almacenar el public_id de Cloudinary
  // Archivada = `estado` en false. Cuándo se archivó, para decirlo en la
  // cartera y al intentar registrarla de nuevo. Null en las activas (y en las
  // que se "eliminaron" antes de que existiera el archivo).
  fechaArchivo                               DateTime?                     @map("fecha_archivo")
  // Color primario con que la ve su gente (hex de la paleta de antd que
  // ofrece el front). Null = el azul por defecto de antd.
  colorPrimario                              String?                       @map("color_primario")
  // Configuración y vigencias: valores por defecto de la PRIMERA campaña.
  // Las de cada ciclo viven en CampanaEvaluacion (la API las devuelve
  // combinadas con las de la campaña en curso).
  modeloEmpresa                              String                        @default("90") // 90, 180
  fechaVigenciaInicio                        DateTime?                     @map("fecha_vigencia_inicio")
  fechaVigenciaFin                           DateTime?                     @map("fecha_vigencia_fin")
  fechaVigenciaInicioObjetivo                DateTime?                     @map("fecha_vigencia_inicio_objetivo")
  fechaVigenciaFinObjetivo                   DateTime?                     @map("fecha_vigencia_fin_objetivo")
  porcentajeCompetecias                      Int?                          @map("porcentaje_competencias")
  porcentajeObjetivos                        Int?                          @map("porcentaje_objetivos")
  porcentajeEvaluacionJefeCompetencia        Int?                          @map("porcentaje_evaluacion_jefe_competencia")
  porcentajeEvaluacionSubordinadoCompetencia Int?                          @map("porcentaje_evaluacion_subordinado_competencia")
  tipoCalificacionCompetencia                String?                       @default("LIKERT") @map("tipo_calificacion_competencia")
  periodoEvaluacion                          String?                       @map("periodo_evaluacion") // 2023-01, 2023-02, 2023-03, etc.
  competenciaResultadoEsperado               Int?                          @map("competencia_resultado_esperado") // 60% ,70% hasta 100%
  estado                                     Boolean                       @default(true)
  creadoPorId                                Int                           @map("creado_por_id")
  actualizadoPorId                           Int?                          @map("actualizado_por_id")
  fechaCreacion                              DateTime                      @default(now()) @map("fecha_creacion")
  fechaModificacion                          DateTime?                     @map("fecha_modificacion")
  areaEmpleadoras                            AreaEmpleadora[]
  puestoEmpleadoras                          PuestoEmpleadora[]
  gerenciaEmpleadoras                        GerenciaEmpleadora[]
  empleados                                  Empleado[]
  unidadOcupacionalEmpleadoras               UnidadOcupacionalEmpleadora[]
  competencias                               Competencia[]
  campanas                                   CampanaEvaluacion[]
  administradores                            Usuario[]
  equipoAsignado                             UsuarioEmpresa[]

  @@map("empresa_empleadora")
}

model AreaEmpleadora {
  idAreaEmpleadora    Int               @id @default(autoincrement()) @map("id_equipo_empleadora")
  descripcion         String
  idEmpresaEmpleadora Int               @map("id_empresa_empleadora")
  empresaEmpleadora   EmpresaEmpleadora @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado              Boolean           @default(true)
  creadoPorId         Int               @map("creado_por_id")
  actualizadoPorId    Int?              @map("actualizado_por_id")
  fechaCreacion       DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?         @map("fecha_modificacion")
  empleados           Empleado[]

  @@map("area_empleadora")
}

model PuestoEmpleadora {
  idPuestoEmpleadora  Int               @id @default(autoincrement()) @map("id_puesto_empleadora")
  descripcion         String
  idEmpresaEmpleadora Int               @map("id_empresa_empleadora")
  empresaEmpleadora   EmpresaEmpleadora @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado              Boolean           @default(true)
  creadoPorId         Int               @map("creado_por_id")
  actualizadoPorId    Int?              @map("actualizado_por_id")
  fechaCreacion       DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?         @map("fecha_modificacion")
  empleados           Empleado[]

  @@map("puesto_empleadora")
}

model GerenciaEmpleadora {
  idGerenciaEmpleadora Int               @id @default(autoincrement()) @map("id_unidad_empleadora")
  descripcion          String
  idEmpresaEmpleadora  Int               @map("id_empresa_empleadora")
  empresaEmpleadora    EmpresaEmpleadora @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado               Boolean           @default(true)
  creadoPorId          Int               @map("creado_por_id")
  actualizadoPorId     Int?              @map("actualizado_por_id")
  fechaCreacion        DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion    DateTime?         @map("fecha_modificacion")
  empleados            Empleado[]

  @@map("gerencia_empleadora")
}

model UnidadOcupacionalEmpleadora {
  idUnidadOcupacionalEmpleadora      Int                                 @id @default(autoincrement()) @map("id_unidad_ocupacional_empleadora")
  descripcion                        String
  idEmpresaEmpleadora                Int                                 @map("id_empresa_empleadora")
  empresaEmpleadora                  EmpresaEmpleadora                   @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado                             Boolean                             @default(true)
  creadoPorId                        Int                                 @map("creado_por_id")
  actualizadoPorId                   Int?                                @map("actualizado_por_id")
  fechaCreacion                      DateTime                            @default(now()) @map("fecha_creacion")
  fechaModificacion                  DateTime?                           @map("fecha_modificacion")
  empleados                          Empleado[]
  unidadOcupacionalCompetenciaNivels UnidadOcupacionalCompetenciaNivel[]

  @@map("unidad_ocupacional_empleadora")
}

// TODO: OBJETIVOS Y DETALLES
model Objetivo {
  idObjetivo                Int                        @id @default(autoincrement()) @map("id_objetivo")
  idEmpleado                Int
  empleado                  Empleado                   @relation(fields: [idEmpleado], references: [idEmpleado])
  // Campaña ("YYYY-MM") a la que pertenece, copiada de la empresa al crearlo.
  // Sin esto los objetivos de un ciclo se mezclaban con los del siguiente.
  periodoEvaluacion         String?                    @map("periodo_evaluacion")
  idCampanaEvaluacion       Int?                       @map("id_campana_evaluacion")
  campana                   CampanaEvaluacion?         @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  estado                    Boolean                    @default(true)
  creadoPorId               Int                        @map("creado_por_id")
  actualizadoPorId          Int?                       @map("actualizado_por_id")
  fechaCreacion             DateTime                   @default(now()) @map("fecha_creacion")
  fechaModificacion         DateTime?                  @map("fecha_modificacion")
  objetivoDetalles          ObjetivoDetalle[]
  retroalimentacionDetalles RetroalimentacionDetalle[]
  evidencias                Evidencia[]

  @@index([idEmpleado, periodoEvaluacion], map: "objetivo_periodo_idx")
  @@index([idCampanaEvaluacion])
  @@map("objetivo")
}

model ObjetivoDetalle {
  idObjetivoDetalle     Int       @id @default(autoincrement()) @map("id_objetivo_detalle")
  idObjetivo            Int       @map("id_objetivo")
  objetivo              Objetivo  @relation(fields: [idObjetivo], references: [idObjetivo])
  tipoCalculo           String    @map("tipo_calculo") // 'ASCENDENTE', 'DESCENDENTE', 'MANUAL
  secuencial            Int
  descripcion           String
  descripcionIniciativa String?   @map("descripcion_iniciativa")
  unidadMedida          String    @map("unidad_medida") // 'PORCENTAJE', 'UNIDAD'
  pesoEspecifico        Float     @map("peso_especifico")
  metaObjetivo          Float     @map("meta_objetivo")
  metaAlcanzada         Float?    @map("meta_alcanzada")
  fechaCulminacion      DateTime  @map("fecha_culminacion")
  porcentajeLogrado     Float?    @map("porcentaje_logrado") // EFECTIVIDAD
  estado                Boolean   @default(true)
  creadoPorId           Int       @map("creado_por_id")
  actualizadoPorId      Int?      @map("actualizado_por_id")
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion")
  fechaModificacion     DateTime? @map("fecha_modificacion")

  @@map("objetivo_detalle")
  evidencias            Evidencia[]
}

// TODO: TABLAS MAESTRAS Y DETALLES
model TablaMaestra {
  idTablaMaestra      Int                   @id @default(autoincrement()) @map("id_tabla_maestra")
  descripcion         String?
  estado              Boolean               @default(true)
  creadoPorId         Int                   @map("creado_por_id")
  actualizadoPorId    Int?                  @map("actualizado_por_id")
  fechaCreacion       DateTime              @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?             @map("fecha_modificacion")
  TablaMaestraDetalle TablaMaestraDetalle[]

  @@map("tabla_maestra")
}

model TablaMaestraDetalle {
  idTablaMaestraDetalle Int          @id @default(autoincrement()) @map("id_tabla_maestra_detalle")
  descripcion           String?
  valor                 String?
  idTablaMaestra        Int          @map("id_tabla_maestra")
  tablaMaestra          TablaMaestra @relation(fields: [idTablaMaestra], references: [idTablaMaestra])
  estado                Boolean      @default(true)
  creadoPorId           Int          @map("creado_por_id")
  actualizadoPorId      Int?         @map("actualizado_por_id")
  fechaCreacion         DateTime     @default(now()) @map("fecha_creacion")
  fechaModificacion     DateTime?    @map("fecha_modificacion")

  @@map("tabla_maestra_detalle")
}

// TODO: COMPETENECIA, NIVEL, ITEM
model Competencia {
  idCompetencia                      Int                                 @id @default(autoincrement()) @map("id_competencia")
  nombre                             String
  titulo                             String
  codigo                             String
  idEmpresaEmpleadora                Int                                 @map("id_empresa_empleadora") // TODO
  empresaEmpleadora                  EmpresaEmpleadora                   @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  estado                             Boolean                             @default(true)
  creadoPorId                        Int                                 @map("creado_por_id")
  actualizadoPorId                   Int?                                @map("actualizado_por_id")
  fechaCreacion                      DateTime                            @default(now()) @map("fecha_creacion")
  fechaModificacion                  DateTime?                           @map("fecha_modificacion")
  niveles                            CompetenciaNivel[]
  evaluacionCompetencias             EvaluacionCompetencia[]
  unidadOcupacionalCompetenciaNivels UnidadOcupacionalCompetenciaNivel[]

  @@map("competencia")
}

model CompetenciaNivel {
  idCompetenciaNivel                 Int                                 @id @default(autoincrement()) @map("id_competencia_nivel")
  nivel                              Int // 1, 2, 3, 4, 5...
  idCompetencia                      Int                                 @map("id_competencia")
  competencia                        Competencia                         @relation(fields: [idCompetencia], references: [idCompetencia])
  estado                             Boolean                             @default(true)
  creadoPorId                        Int                                 @map("creado_por_id")
  actualizadoPorId                   Int?                                @map("actualizado_por_id")
  fechaCreacion                      DateTime                            @default(now()) @map("fecha_creacion")
  fechaModificacion                  DateTime?                           @map("fecha_modificacion")
  items                              CompetenciaNivelItem[]
  evaluacionCompetencias             EvaluacionCompetencia[]
  unidadOcupacionalCompetenciaNivels UnidadOcupacionalCompetenciaNivel[]

  @@map("competencia_nivel")
}

model CompetenciaNivelItem {
  idCompetenciaNivelItem     Int                         @id @default(autoincrement()) @map("id_competencia_nivel_item")
  enunciado                  String
  secuencial                 Int
  idCompetenciaNivel         Int                         @map("id_competencia_nivel")
  nivel                      CompetenciaNivel            @relation(fields: [idCompetenciaNivel], references: [idCompetenciaNivel])
  estado                     Boolean                     @default(true)
  creadoPorId                Int                         @map("creado_por_id")
  actualizadoPorId           Int?                        @map("actualizado_por_id")
  fechaCreacion              DateTime                    @default(now()) @map("fecha_creacion")
  fechaModificacion          DateTime?                   @map("fecha_modificacion")
  evaluacionCompetenciaItems EvaluacionCompetenciaItem[]

  @@map("competencia_nivel_item")
}

// TODO: RELACIÓN: Unidad Ocupacional → Competencia (nivel asignado)
model UnidadOcupacionalCompetenciaNivel {
  idUnidadOcupacionalCompetenciaNivel Int                         @id @default(autoincrement()) @map("id_unidad_ocupacional_competencia_nivel")
  idUnidadOcupacionalEmpleadora       Int                         @map("id_unidad_ocupacional_empleadora")
  unidadOcupacionalEmpleadora         UnidadOcupacionalEmpleadora @relation(fields: [idUnidadOcupacionalEmpleadora], references: [idUnidadOcupacionalEmpleadora])
  idCompetencia                       Int                         @map("id_competencia")
  competencia                         Competencia                 @relation(fields: [idCompetencia], references: [idCompetencia])
  idCompetenciaNivel                  Int                         @map("id_competencia_nivel") // Nivel 3, 4, 5, etc.
  competenciaNivel                    CompetenciaNivel            @relation(fields: [idCompetenciaNivel], references: [idCompetenciaNivel])

  @@unique([idUnidadOcupacionalEmpleadora, idCompetencia]) // 1 competencia → 1 nivel por unidad
  @@map("unidad_ocupacional_competencia_nivel")
}

// TODO: EVALUACIÓN DE COMPETENCIAS
model EvaluacionCompetencia {
  idEvaluacionCompetencia Int                         @id @default(autoincrement())
  // Evaluado (trabajador evaluado)
  idEvaluado              Int?                        @map("id_evaluado")
  evaluado                Empleado?                   @relation("evaluado", fields: [idEvaluado], references: [idEmpleado])
  // Evaluador (jefe, evaluador interno o autoevaluación)
  idEvaluador             Int?                        @map("id_evaluador")
  evaluador               Empleado?                   @relation("evaluador", fields: [idEvaluador], references: [idEmpleado])
  // Competencia evaluada
  idCompetencia           Int                         @map("id_competencia")
  competencia             Competencia                 @relation(fields: [idCompetencia], references: [idCompetencia])
  // Nivel de la competencia asignado por la unidad
  idCompetenciaNivel      Int                         @map("id_competencia_nivel")
  nivel                   CompetenciaNivel            @relation(fields: [idCompetenciaNivel], references: [idCompetenciaNivel])
  // Periodo de la campaña al que pertenece la evaluación ("YYYY-MM").
  // Se copia de `EmpresaEmpleadora.periodoEvaluacion` al iniciarla y NO se
  // vuelve a tocar: es lo que separa una campaña de la siguiente. Sin este
  // campo, la evaluación del periodo nuevo reabría la fila del periodo viejo
  // y sobrescribía sus calificaciones.
  periodoEvaluacion       String?                     @map("periodo_evaluacion")
  idCampanaEvaluacion     Int?                        @map("id_campana_evaluacion")
  campana                 CampanaEvaluacion?          @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  // Foto de la estructura al iniciar la evaluación. El vínculo jefe/
  // subordinado y la unidad se leían del estado ACTUAL del empleado, así que
  // un cambio de jefe, puesto o unidad reescribía evaluaciones ya hechas: las
  // notas del jefe anterior pasaban a "otro" y dejaban de contar.
  // `tipoEvaluador`: AUTO | JEFE | SUBORDINADO | OTRO (ver origenDeEvaluacion).
  tipoEvaluador           String?                     @map("tipo_evaluador")
  codigoJefeEvaluado      String?                     @map("codigo_jefe_evaluado")
  idUnidadEvaluado        Int?                        @map("id_unidad_evaluado")
  idPuestoEvaluado        Int?                        @map("id_puesto_evaluado")
  idAreaEvaluado          Int?                        @map("id_area_evaluado")
  idGerenciaEvaluado      Int?                        @map("id_gerencia_evaluado")
  // Estado funcional de la evaluación
  estadoEvaluacion        String                      @default("PROCESO")
  // Valores recomendados:
  // PROCESO → editable
  // CERRADA → no editable
  // ANULADA → error o histórico
  // Comentario general del evaluador
  comentarioGeneral       String?
  // Soft delete
  estado                  Boolean                     @default(true)
  // Auditoría
  creadoPorId             Int                         @map("creado_por_id")
  actualizadoPorId        Int?                        @map("actualizado_por_id")
  fechaCreacion           DateTime                    @default(now()) @map("fecha_creacion")
  fechaModificacion       DateTime?                   @map("fecha_modificacion")
  // Relación a ítems evaluados
  itemsEvaluados          EvaluacionCompetenciaItem[]
  evidencias              Evidencia[]

  @@index([idEvaluado, idEvaluador, idCompetencia, periodoEvaluacion], map: "evaluacion_competencia_periodo_idx")
  @@index([idCampanaEvaluacion])
  @@map("evaluacion_competencia")
}

model EvaluacionCompetenciaItem {
  idEvaluacionCompetenciaItem Int                   @id @default(autoincrement()) @map("id_evaluacion_competencia_item")
  // Relación con la evaluación
  idEvaluacionCompetencia     Int                   @map("id_evaluacion_competencia")
  evaluacion                  EvaluacionCompetencia @relation(fields: [idEvaluacionCompetencia], references: [idEvaluacionCompetencia])
  // Ítem del nivel evaluado
  idCompetenciaNivelItem      Int                   @map("id_competencia_nivel_item")
  item                        CompetenciaNivelItem  @relation(fields: [idCompetenciaNivelItem], references: [idCompetenciaNivelItem])
  // RESULTADOS DE LA EVALUACIÓN
  // Nota / puntaje / valor (1 al 5, 1 al 3, o escala que definas)
  calificacion                Int?
  // Snapshot del texto del ítem en el momento de la evaluación:
  // IMPORTANTÍSIMO para que futuras modificaciones no cambien evaluaciones antiguas
  textoItemEvaluado           String?
  estado                      Boolean               @default(true)
  creadoPorId                 Int                   @map("creado_por_id")
  actualizadoPorId            Int?                  @map("actualizado_por_id")
  fechaCreacion               DateTime              @default(now()) @map("fecha_creacion")
  fechaModificacion           DateTime?             @map("fecha_modificacion")

  @@map("evaluacion_competencia_item")
}

// TODO: Para gestión de EMPLEOS y COMUNICADOS LANDING PAGE TEAMWORK
model Empleo {
  idEmpleo            Int          @id @default(autoincrement()) @map("id_empleo")
  titulo              String
  descripcion         String?
  nombreEmpresa       String       @map("nombre_empresa")
  ubicacion           String
  tipoEmpleo          String       @map("tipo_empleo")
  modalidad           String?
  fechaPublicacion    DateTime     @map("fecha_publicacion")
  fechaFinPublicacion DateTime     @map("fecha_fin_publicacion")
  tiempoExperiencia   String       @map("tiempo_experiencia")
  numeroVacantes      String       @map("numero_vacantes")
  salario             String?
  estado              Boolean      @default(true)
  creadoPorId         Int          @map("creado_por_id")
  actualizadoPorId    Int?         @map("actualizado_por_id")
  fechaCreacion       DateTime     @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?    @map("fecha_modificacion")
  comunicados         Comunicado[]

  @@map("empleo")
}

model Comunicado {
  idComunicado      Int       @id @default(autoincrement()) @map("id_comunicado")
  titulo            String
  url               String?
  estadoDisponible  Boolean   @default(true) @map("estado_disponible")
  idEmpleo          Int       @map("id_empleo")
  empleo            Empleo    @relation(fields: [idEmpleo], references: [idEmpleo])
  estado            Boolean   @default(true)
  creadoPorId       Int       @map("creado_por_id")
  actualizadoPorId  Int?      @map("actualizado_por_id")
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime? @map("fecha_modificacion")

  @@map("comunicado")
}

model RetroalimentacionDetalle {
  idRetroalimentacionDetalle Int       @id @default(autoincrement()) @map("id_retroalimentacion_detalle")
  idObjetivo                 Int       @map("id_objetivo")
  objetivo                   Objetivo  @relation(fields: [idObjetivo], references: [idObjetivo])
  descripcionObjetivo        String?   @map("descripcion_objetivo")
  descripcionActividad       String?   @map("descripcion_actividad")
  descripcionFecha           String?   @map("descripcion_fecha")
  descripcionEstado          String?   @map("descripcion_estado")
  estado                     Boolean   @default(true)
  actualizadoPorId           Int?      @map("actualizado_por_id")
  fechaCreacion              DateTime  @default(now()) @map("fecha_creacion")
  fechaModificacion          DateTime? @map("fecha_modificacion")

  @@map("retroalimentacion_detalle")
}

model Evidencia {
  idEvidencia             Int                    @id @default(autoincrement())
  idEvaluacionCompetencia Int?                   @map("id_evaluacion_competencia")
  evaluacion              EvaluacionCompetencia? @relation(fields: [idEvaluacionCompetencia], references: [idEvaluacionCompetencia])
  idObjetivo              Int?                   @map("id_objetivo")
  objetivo                Objetivo?              @relation(fields: [idObjetivo], references: [idObjetivo])
  /// La meta concreta que sustenta (además de su ficha en `idObjetivo`).
  idObjetivoDetalle       Int?                   @map("id_objetivo_detalle")
  objetivoDetalle         ObjetivoDetalle?       @relation(fields: [idObjetivoDetalle], references: [idObjetivoDetalle])
  idEmpleado              Int                    @map("id_empleado")
  empleado                Empleado               @relation(fields: [idEmpleado], references: [idEmpleado])
  nombreArchivo           String
  urlArchivo              String
  publicId                String? // útil si usas Cloudinary o S3
  tipoArchivo             String // pdf, docx, etc.
  // Campaña ("YYYY-MM") en la que se subió.
  periodoEvaluacion       String?                @map("periodo_evaluacion")
  idCampanaEvaluacion     Int?                   @map("id_campana_evaluacion")
  campana                 CampanaEvaluacion?     @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  estado                  Boolean                @default(true)
  creadoPorId             Int                    @map("creado_por_id")
  actualizadoPorId        Int?                   @map("actualizado_por_id")
  fechaCreacion           DateTime               @default(now()) @map("fecha_creacion")
  fechaModificacion       DateTime?              @map("fecha_modificacion")

  @@map("evidencia")
}

// Relacionado al idEmpleado  

// Una campaña (ciclo) de evaluación de una empresa: nombre, periodo evaluado,
// ventanas del proceso y la configuración con la que se califica. Evaluaciones,
// objetivos y evidencias pertenecen a una campaña por `idCampanaEvaluacion`.
// Reglas (en el servicio, Prisma no modela índices parciales): una sola
// campaña EN_CURSO por empresa y periodos evaluados que no se superponen.
model CampanaEvaluacion {
  idCampanaEvaluacion                        Int               @id @default(autoincrement()) @map("id_campana_evaluacion")
  idEmpresaEmpleadora                        Int               @map("id_empresa_empleadora")
  empresaEmpleadora                          EmpresaEmpleadora @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  nombre                                     String
  // Tramo de desempeño que se evalúa (no cuándo se califica: eso son las
  // vigencias de abajo).
  periodoDesde                               DateTime          @map("periodo_desde")
  periodoHasta                               DateTime          @map("periodo_hasta")
  // Cuándo se puede calificar.
  fechaVigenciaInicio                        DateTime          @map("fecha_vigencia_inicio")
  fechaVigenciaFin                           DateTime          @map("fecha_vigencia_fin")
  fechaVigenciaInicioObjetivo                DateTime?         @map("fecha_vigencia_inicio_objetivo")
  fechaVigenciaFinObjetivo                   DateTime?         @map("fecha_vigencia_fin_objetivo")
  // Configuración de ESTA campaña (se copia de la empresa al abrirla).
  modeloEmpresa                              String            @map("modelo_empresa")
  porcentajeCompetecias                      Int?              @map("porcentaje_competencias")
  porcentajeObjetivos                        Int?              @map("porcentaje_objetivos")
  porcentajeEvaluacionJefeCompetencia        Int?              @map("porcentaje_evaluacion_jefe")
  porcentajeEvaluacionSubordinadoCompetencia Int?              @map("porcentaje_evaluacion_subordinado")
  tipoCalificacionCompetencia                String?           @map("tipo_calificacion")
  competenciaResultadoEsperado               Int?              @map("resultado_esperado")
  // EN_CURSO | CERRADA
  estado                                     String            @default("EN_CURSO")
  // "YYYY-MM" heredado del modelo anterior. Solo para la transición: las
  // campañas nuevas no lo usan y se eliminará.
  periodoEvaluacion                          String?           @map("periodo_evaluacion")
  fechaCreacion                              DateTime          @default(now()) @map("fecha_creacion")
  creadoPorId                                Int?              @map("creado_por_id")
  fechaCierre                                DateTime?         @map("fecha_cierre")
  cerradoPorId                               Int?              @map("cerrado_por_id")
  // Reapertura (solo admin): queda registrado quién y cuándo.
  fechaReapertura                            DateTime?         @map("fecha_reapertura")
  reabiertoPorId                             Int?              @map("reabierto_por_id")

  evaluaciones      EvaluacionCompetencia[]
  objetivos         Objetivo[]
  evidencias        Evidencia[]
  CampanaAsignacion CampanaAsignacion[]
  ajustesCalibracion AjusteCalibracion[]
  sesionesRetroalimentacion SesionRetroalimentacion[]
  hitos                     HitoCampana[]

  @@unique([idEmpresaEmpleadora, periodoEvaluacion])
  @@index([idEmpresaEmpleadora, estado])
  @@map("campana_evaluacion")
}

// Foto de lo que le tocaba evaluar a cada trabajador al CERRAR la campaña
// (competencias y nivel de su unidad ocupacional en ese momento). Las campañas
// cerradas calculan "asignadas" con esto: la unidad de hoy puede ser otra, y
// sin la foto una competencia asignada que nadie evaluó dejaba de contar como
// 0 al cerrar, cambiando el resultado. Reabrir la campaña borra la foto.
model CampanaAsignacion {
  idCampanaAsignacion Int               @id @default(autoincrement()) @map("id_campana_asignacion")
  idCampanaEvaluacion Int               @map("id_campana_evaluacion")
  campana             CampanaEvaluacion @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  idEmpleado          Int               @map("id_empleado")
  idCompetencia       Int               @map("id_competencia")
  idCompetenciaNivel  Int               @map("id_competencia_nivel")

  @@unique([idCampanaEvaluacion, idEmpleado, idCompetencia])
  @@map("campana_asignacion")
}

/// Empresas que atiende una cuenta del equipo de TeamWork (rol EQUIPO).
model UsuarioEmpresa {
  idUsuario           Int               @map("id_usuario")
  usuario             Usuario           @relation(fields: [idUsuario], references: [idUsuario])
  idEmpresaEmpleadora Int               @map("id_empresa_empleadora")
  empresaEmpleadora   EmpresaEmpleadora @relation(fields: [idEmpresaEmpleadora], references: [idEmpresaEmpleadora])
  asignadoPorId       Int?              @map("asignado_por_id")
  fechaAsignacion     DateTime          @default(now()) @map("fecha_asignacion")

  @@id([idUsuario, idEmpresaEmpleadora])
  @@index([idEmpresaEmpleadora])
  @@map("usuario_empresa")
}

/// Bitácora: quién hizo qué, cuándo y en qué empresa. Solo se agrega: un
/// trigger de la base rechaza UPDATE y DELETE. Los datos del autor se copian
/// (no son relación) para que el registro se lea aunque la cuenta cambie.
/// Nunca guarda contraseñas.
model RegistroActividad {
  idRegistro          Int      @id @default(autoincrement()) @map("id_registro")
  fecha               DateTime @default(now())
  idUsuario           Int?     @map("id_usuario")
  usuarioCodigo       String?  @map("usuario_codigo")
  usuarioNombre       String?  @map("usuario_nombre")
  usuarioRol          String?  @map("usuario_rol")
  idEmpresaEmpleadora Int?     @map("id_empresa_empleadora")
  /// CREAR | EDITAR | ELIMINAR | CAMBIAR_SITUACION | IMPORTAR | INICIAR_SESION | INICIO_FALLIDO | OTRA
  accion              String
  entidad             String
  idEntidad           String?  @map("id_entidad")
  descripcion         String
  /// { antes, despues } de los campos que cambiaron, o lo enviado.
  detalle             Json?
  metodo              String?
  ruta                String?
  resultado           String   @default("OK")
  codigoHttp          Int?     @map("codigo_http")
  ip                  String?
  userAgent           String?  @map("user_agent")

  @@index([idEmpresaEmpleadora, fecha])
  @@index([idUsuario, fecha])
  @@index([fecha])
  @@map("registro_actividad")
}

/// Configuración de la plataforma TeamWork (no de una empresa): una sola
/// fila, id 1. Hoy guarda el color primario de la consola de TeamWork.
model ConfiguracionPlataforma {
  id                Int       @id @default(1)
  // Hex; null = el azul por defecto de antd.
  colorPrimario     String?   @map("color_primario")
  fechaModificacion DateTime? @map("fecha_modificacion")
  actualizadoPorId  Int?      @map("actualizado_por_id")

  @@map("configuracion_plataforma")
}

/// Ajuste de calibración: el comité corrige el resultado de competencias y/o
/// de objetivos de un trabajador en una campaña, con motivo. Uno por
/// trabajador y campaña; los originales se guardan para el acta.
model AjusteCalibracion {
  idAjusteCalibracion   Int               @id @default(autoincrement()) @map("id_ajuste_calibracion")
  idCampanaEvaluacion   Int               @map("id_campana_evaluacion")
  campana               CampanaEvaluacion @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  idEmpleado            Int               @map("id_empleado")
  empleado              Empleado          @relation(fields: [idEmpleado], references: [idEmpleado])
  /// Resultado ajustado; null = ese componente no se ajusta.
  competencias          Float?
  objetivos             Float?
  /// Lo que daba el cálculo al ajustar (para el acta).
  competenciasOriginal  Float?            @map("competencias_original")
  objetivosOriginal     Float?            @map("objetivos_original")
  motivo                String
  creadoPorId           Int               @map("creado_por_id")
  actualizadoPorId      Int?              @map("actualizado_por_id")
  fechaCreacion         DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion     DateTime?         @map("fecha_modificacion")

  @@unique([idCampanaEvaluacion, idEmpleado])
  @@map("ajuste_calibracion")
}

/// Sesión de retroalimentación (guía FONAFE, pp. 33–34): el jefe comunica el
/// resultado de la campaña, fortalezas, oportunidades y compromisos; el
/// trabajador responde si está conforme. Una por trabajador y campaña, sin
/// depender de la ficha de objetivos.
model SesionRetroalimentacion {
  idSesionRetroalimentacion Int               @id @default(autoincrement()) @map("id_sesion_retroalimentacion")
  idCampanaEvaluacion       Int               @map("id_campana_evaluacion")
  campana                   CampanaEvaluacion @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  idEmpleado                Int               @map("id_empleado")
  empleado                  Empleado          @relation("retroEvaluado", fields: [idEmpleado], references: [idEmpleado])
  /// Quien la registró (su jefe inmediato).
  idJefe                    Int               @map("id_jefe")
  jefe                      Empleado          @relation("retroJefe", fields: [idJefe], references: [idEmpleado])
  fechaSesion               DateTime          @map("fecha_sesion") @db.Date
  fortalezas                String
  oportunidades             String
  compromisos               String
  /// PENDIENTE, CONFORME o NO_CONFORME.
  conformidad               String            @default("PENDIENTE")
  comentarioTrabajador      String?           @map("comentario_trabajador")
  fechaRespuesta            DateTime?         @map("fecha_respuesta")
  creadoPorId               Int               @map("creado_por_id")
  actualizadoPorId          Int?              @map("actualizado_por_id")
  fechaCreacion             DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion         DateTime?         @map("fecha_modificacion")

  @@unique([idCampanaEvaluacion, idEmpleado])
  @@map("sesion_retroalimentacion")
}

/// Hito del proceso de una campaña (guía FONAFE, pp. 36–39): la acción que
/// se debe realizar y el registro que la sustenta. La lista es de cada
/// campaña y la arma RR. HH. (sugerida de FONAFE, copiada de la anterior o a
/// mano). Se cumple cuando tiene al menos un archivo.
model HitoCampana {
  idHitoCampana       Int               @id @default(autoincrement()) @map("id_hito_campana")
  idCampanaEvaluacion Int               @map("id_campana_evaluacion")
  campana             CampanaEvaluacion @relation(fields: [idCampanaEvaluacion], references: [idCampanaEvaluacion])
  etapa               String
  nombre              String
  /// Qué registro se espera (y, si TeamWork lo genera, dónde descargarlo).
  registro            String
  orden               Int               @default(0)
  estado              Boolean           @default(true)
  creadoPorId         Int               @map("creado_por_id")
  actualizadoPorId    Int?              @map("actualizado_por_id")
  fechaCreacion       DateTime          @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime?         @map("fecha_modificacion")
  archivos            RegistroHito[]

  @@index([idCampanaEvaluacion])
  @@map("hito_campana")
}

/// Archivo que sustenta un hito (acta, cronograma, matriz aprobada…).
model RegistroHito {
  idRegistroHito    Int         @id @default(autoincrement()) @map("id_registro_hito")
  idHitoCampana     Int         @map("id_hito_campana")
  hito              HitoCampana @relation(fields: [idHitoCampana], references: [idHitoCampana])
  nombreArchivo     String      @map("nombre_archivo")
  urlArchivo        String      @map("url_archivo")
  publicId          String?     @map("public_id")
  tipoArchivo       String      @map("tipo_archivo")
  estado            Boolean     @default(true)
  creadoPorId       Int         @map("creado_por_id")
  actualizadoPorId  Int?        @map("actualizado_por_id")
  fechaCreacion     DateTime    @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime?   @map("fecha_modificacion")

  @@map("registro_hito")
}
