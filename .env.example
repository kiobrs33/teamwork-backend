# ============================================================
#  .env.example — plantilla versionada
# ============================================================
# Copiar y rellenar. Es el único archivo de entorno que está en git; el resto
# (.env, .env.development) están gitignoreados.
#
#   cp .env.example .env              # y dejar solo DATABASE_URL
#   cp .env.example .env.development  # y quitar DATABASE_URL
#
# Reparto de archivos:
#   .env              → DATABASE_URL. Lo lee el CLI de Prisma y, como
#                       fallback, Nest.
#   .env.development  → el resto, para NODE_ENV=development.
#   producción        → sin archivo: las inyecta la plataforma de despliegue.
#
# Las marcadas REQUERIDA se validan al arrancar: si falta una, el backend no
# levanta y dice cuál (src/config/env.validation.ts).
# ============================================================

# REQUERIDA. Postgres. En local, el contenedor de `teamwork-docker`.
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:6025/teamwork_db?schema=public

# Puerto de la API. Por defecto 4055, que es el que espera el front.
PORT=4055

# REQUERIDA. Secreto de firma del JWT. Sin esto el login no funciona.
JWT_SECRET_KEY=

# Vigencia del token. Por defecto 7d.
JWT_EXPIRATION=7d

# Subida del logo de empresa. Sin esto el backend arranca, pero la subida falla.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
