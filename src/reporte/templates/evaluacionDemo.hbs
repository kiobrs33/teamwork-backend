    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    <script>
      const chartData = {{{json chartData}}};

      /* ===== BAR ===== */
       /* new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: chartData,
        options: {
          responsive: false,
          animation: false,
          scales: {
            y: {
              beginAtZero: true,
              max: 100
            }
