      /* ===== PIE ===== */
      /* new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.datasets[0].data,
            backgroundColor: [
              '#1890ff',
              '#52c41a',
              '#faad14',
              '#f5222d',
              '#722ed1'
            ]
          }]
        },
        options: {
          responsive: false,
          animation: false
        }
      }); */

      // OBJETIVOS BAR HORIZONTAL
      const objetivosChart = {{{json objetivosChart}}};
      new Chart(document.getElementById('objetivosComparacionChart'), {
        type: 'bar',

        data: objetivosChart,

        options: {
          indexAxis: 'y',

          responsive: false,
          animation: false,

          layout: {
            padding: 10
          },

          scales: {
            x: {
              beginAtZero: true,
              max: 120,

              grid: {
                color: '#e8e8e8'
              },

              ticks: {
                font: {
                  size: 11
                },

                callback: function(value) {
                  return value + '%';
                }
              }
            },

            y: {
              grid: {
                display: false
              },

              ticks: {
                font: {
                  size: 11,
                  weight: 'bold'
                }
              }
            }
          },

          plugins: {

            legend: {
              position: 'top',

              labels: {
                boxWidth: 14,
                font: {
                  size: 12,
                  weight: 'bold'
                }
              }
            },

            tooltip: {
              callbacks: {
                label: function(ctx) {
                  return ctx.dataset.label + ': ' + ctx.raw + '%';
                }
              }
            },

            datalabels: {
              anchor: 'end',
              align: 'right',

              color: '#000',

              font: {
                weight: 'bold',
                size: 11
              },

              formatter: (value) => value + '%'
            }

          },

          datasets: {
            bar: {
              borderRadius: 0,
              borderWidth: 1,
              barThickness: 18
            }
          }
        },

        plugins: [ChartDataLabels]

      });


      // COMPETENCIAS DOUGHNUT
     const doughnutData = {{{json competenciasDoughnutChart}}};

const centerTextPlugin = {
  id: 'centerText',

  beforeDraw(chart) {

    const { width, height, ctx } = chart;

    ctx.restore();

    const fontSize = (height / 4).toFixed(2);

    ctx.font = fontSize + "px Arial";
    ctx.textBaseline = "middle";
    ctx.textAlign = "center";

    ctx.fillStyle = "#1677ff";

    const text = doughnutData.porcentaje + "%";

    const textX = width / 2;
    const textY = height / 2;

    ctx.fillText(text, textX, textY);

    ctx.save();
  }
};


new Chart(document.getElementById('doughnutChart'), {

  type: 'doughnut',

  data: {
    labels: ['Resultado', 'Pendiente'],

    datasets: [
      {
        data: [
          doughnutData.porcentaje,
          doughnutData.restante
        ],

        backgroundColor: [
          '#1677ff',
          '#f0f0f0'
        ],

        hoverBackgroundColor: [
          '#0958d9',
          '#d9d9d9'
        ],

        borderWidth: 0
      }
    ]
  },

  options: {

    responsive: true,
    maintainAspectRatio: false,

    layout: {
      padding: 10
    },

    cutout: '75%',

    plugins: {

      legend: {

        position: 'bottom',

        labels: {

          font: {
            size: 12,
            weight: 'bold'
          },

          boxWidth: 12
        }
      },

      tooltip: {
        callbacks: {
          label: function(ctx) {
            return ctx.label + ": " + ctx.raw + "%";
          }
        }
      }

    }

  },

  plugins: [centerTextPlugin]

});

      // COMPETENCIAS RADAR
      const radarData = {{{json competenciasRadarChart}}};
      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: radarData,
        options: {
          responsive: false,
          animation: false,

          plugins: {
            legend: {
              position: 'bottom', // 👈 leyenda abajo
              labels: {
                font: {
                  size: 12
                },
                boxWidth: 15
              }
            }
          },

          elements: {
            line: {
              borderWidth: 2
            },
            point: {
              radius: 4,
              hoverRadius: 6
            }
          },

          scales: {
            r: {
              beginAtZero: true,
              max: 100,
              ticks: {
                stepSize: 25,
                backdropColor: 'transparent',
                font: {
                  size: 10
                }
              },

              grid: {
                color: '#e8e8e8'
              },

              angleLines: {
                color: '#d9d9d9'
              },

              pointLabels: {
                font: {
                  size: 8,
                  weight: 'bold',
                },
                color: '#333',
                // display: false
              }
            }
          }
        }
      });

      // EVALUACION FINAL DOUGHNUT
      const porcentajeFinal = {{{resultados.evaluacionFinal}}};
const restanteFinal = 100 - porcentajeFinal;

const centerTextFinal = {
  id: 'centerTextFinal',
  beforeDraw(chart) {
    const { ctx, chartArea } = chart;

    if (!chartArea) return;

    const { left, right, top, bottom } = chartArea;

    const width = right - left;
    const height = bottom - top;

    ctx.save();

    const fontSize = Math.min(width, height) / 6;
    ctx.font = `${fontSize}px Arial`;
    ctx.fillStyle = "#2f80ed";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    const text = porcentajeFinal + "%";

    const centerX = left + width / 2;
    const centerY = top + height / 2;

    ctx.fillText(text, centerX, centerY);

    ctx.restore();
  }
};

new Chart(document.getElementById('evaluacionFinalChart'), {
  type: 'doughnut',

  data: {
    labels: ['Resultado ED', 'Pendiente'],
    datasets: [{
      data: [porcentajeFinal, restanteFinal],
      backgroundColor: [
        '#2f80ed',
        '#e5e5e5'
      ],
      borderWidth: 0
    }]
  },

  options: {
    responsive: false,
    cutout: '90%',

    plugins: {
      legend: {
        position: 'bottom',
        labels: {
          font: {
            size: 12
          }
        }
      }
    }
  },

  plugins: [centerTextFinal]
});
    </script>
