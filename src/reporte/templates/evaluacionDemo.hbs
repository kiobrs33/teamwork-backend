      {{#each competenciasDetalle}}
        <div class="table">
          <table>
            <thead>
              <tr>
                <th class="table__header">Competencia</th>
                <th class="table__header">Autevaluacion</th>
                <th class="table__header">Resultado Alcanzado</th>
                <th class="table__header">Resultado Esperado</th>
                <th class="table__header">Superavit / Oportunidad de mejora</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="table__cell">
                  <strong>{{orden}}</strong><br> {{competencia}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{autoevaluacion}}%
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{resultadoFinal}}%
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{competenciaResultadoEsperado}}%
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{#if superavit}}
                    <span style="color:green;">+{{superavit}}%</span>
                  {{/if}}

                  {{#if oportunidadMejora}}
                    <span style="color:red;">-{{oportunidadMejora}}%</span>
                  {{/if}}

                  {{#unless superavit}}
                    {{#unless oportunidadMejora}}
                      0%
                    {{/unless}}
                  {{/unless}}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      {{/each}}

