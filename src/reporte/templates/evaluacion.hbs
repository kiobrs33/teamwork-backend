<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Reporte de Evaluación de Desempeño</title>
    <style>
      {{{css}}}
    </style>
  </head>
  <body>
    <div class="report">
      <img
        src={{empresa.logo}}
        alt="logo"
        class="report__logo"
      />

      <h2 class="report__title">
        REPORTE DE RESULTADOS Y RETROALIMENTACIÓN DE LA EVALUACIÓN DE DESEMPEÑO
      </h2>

      <h4 class="report__subtitle">DATOS DEL TRABAJADOR</h4>
      <div class="table">
        <table>
          <tbody>
            <tr>
              <td class="table__cell table__cell--bold">
                Codigo:
              </td>
              <td class="table__cell">{{evaluado.codigoEmpleado}}</td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">
                Apellidos y Nombres:
              </td>
              <td class="table__cell">{{evaluado.apellidos}} {{evaluado.nombres}}</td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">Puesto:</td>
              <td class="table__cell">{{empleado.puesto}}</td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">Gerencia:</td>
              <td class="table__cell">{{empleado.gerencia}}</td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">Área:</td>
              <td class="table__cell">{{empleado.area}}</td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">Grupo:</td>
              <td class="table__cell">
                {{empleado.grupo}}
              </td>
            </tr>
            <tr>
              <td class="table__cell table__cell--bold">
                Fecha de Evaluación:
              </td>
              <td class="table__cell">{{fechaEvaluacion}}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="report__title">
        RESULTADO DE LA EVALUACIÓN DE DESEMPEÑO | REPORTE INDIVIDUAL
      </h2>

      <div class="table">
        <table>
          <thead>
            <tr>
              <th class="table__header">Evaluación</th>
              <th class="table__header">Ponderado</th>
              <th class="table__header">Resultado Obtenido</th>
              <th class="table__header">ED General</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="table__cell table__cell--center table__cell--bold">
                Competencias
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{empresa.pesoCompetencias}}%
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{resultados.competencias}}
              </td>
              <td
                rowspan="2"
                class="table__cell table__cell--center table__cell--bold"
              >
                {{resultados.evaluacionFinal}}
              </td>
            </tr>
            <tr>
              <td class="table__cell table__cell--center table__cell--bold">
                Objetivos
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{empresa.pesoObjetivos}}%
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{resultados.objetivos}}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="graphics">
        {{!-- <div class="graphics__item">
          <h4 class="graphics__title">Resultado Obtenido ED General</h4>
          <canvas id="doughnutChart" class="canvas--graphic"></canvas>
        </div> --}}
        <div class="graphics__item">
          <h4 class="graphics__title">Resultado Evaluación de GENERAL</h4>
          <canvas id="evaluacionFinalChart" class="canvas"></canvas>
        </div>
        <div class="graphics__item">
          <h4 class="graphics__title">Resultados de ED por Competencias</h4>
           <canvas id="radarChart" class="canvas"></canvas>
        </div>
      </div>


      {{#each competenciasDetalle}}
        <div class="table">
          <table>
            <thead>
              <tr>
                <th class="table__header">Competencia</th>
                <th class="table__header">Autevaluacion</th>
                <th class="table__header">Resultado Alcanzado</th>
                <th class="table__header">Resultado Esperado</th>
                <th class="table__header">Superavit / Oportunidad de mejora</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="table__cell">
                  {{competencia}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{autoevaluacion}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{resultadoFinal}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  100
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{#if superavit}}
                    <span style="color:green;">+ {{superavit}}</span>
                  {{/if}}

                  {{#if oportunidadMejora}}
                    <span style="color:red;">- {{oportunidadMejora}}</span>
                  {{/if}}

                  {{#unless superavit}}
                    {{#unless oportunidadMejora}}
                      0
                    {{/unless}}
                  {{/unless}}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      {{/each}}

