    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      const chartData = {{{json chartData}}};

      /* ===== BAR ===== */
      new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: chartData,
        options: {
          responsive: false,
          animation: false,
          scales: {
            y: {
              beginAtZero: true,
              max: 100
            }
          }
        }
      });

      /* ===== DOUGHNUT ===== */
      new Chart(document.getElementById('doughnutChart'), {
        type: 'doughnut',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.datasets[0].data,
            backgroundColor: [
              '#1890ff',
              '#52c41a',
              '#faad14',
              '#f5222d',
              '#722ed1'
            ]
          }]
        },
        options: {
          responsive: false,
          animation: false,
          cutout: '60%'
        }
      });

      /* ===== PIE ===== */
      new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.datasets[0].data,
            backgroundColor: [
              '#1890ff',
              '#52c41a',
              '#faad14',
              '#f5222d',
              '#722ed1'
            ]
          }]
        },
        options: {
          responsive: false,
          animation: false
        }
      });

      /* ===== RADAR ===== */
      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: {
          labels: chartData.labels,
          datasets: [{
            label: 'Resultado (%)',
            data: chartData.datasets[0].data,
            backgroundColor: 'rgba(24,144,255,0.2)',
            borderColor: '#1890ff',
            pointBackgroundColor: '#1890ff'
          }]
        },
        options: {
          responsive: false,
          animation: false,
          scales: {
            r: {
              beginAtZero: true,
              max: 100
            }
          }
        }
      });
    </script>
