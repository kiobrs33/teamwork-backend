              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="table__cell">
                  <strong>{{orden}}</strong><br> {{competencia}}
                  {{!-- El 0 de una competencia que nadie evaluó no significa
                        lo mismo que un 0 puesto por el jefe: se dice. --}}
                  {{#if noEvaluada}}
                    <br><span style="color:#d97706; font-size:9px; font-weight:bold;">Sin evaluar · cuenta como 0</span>
                  {{/if}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{autoevaluacion}}%
                  {{!-- La autoevaluación no puntúa; está para detectar esto:
                        el trabajador se pone 100 y el jefe le pone 20. --}}
                  {{#if brecha}}
                    <br><span style="color:#b91c1c; font-size:9px;">Revisar · {{diferencia}} pts de diferencia</span>
                  {{/if}}
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{resultadoFinal}}%
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{competenciaResultadoEsperado}}%
                </td>
                <td class="table__cell table__cell--center table__cell--bold">
                  {{#if superavit}}
                    <span style="color:green;">+{{superavit}}%</span>
                  {{/if}}

                  {{#if oportunidadMejora}}
                    <span style="color:red;">-{{oportunidadMejora}}%</span>
                  {{/if}}

                  {{#unless superavit}}
                    {{#unless oportunidadMejora}}
                      0%
                    {{/unless}}
                  {{/unless}}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      {{/each}}

