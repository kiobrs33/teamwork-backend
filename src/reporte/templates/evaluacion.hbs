    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      const chartData = {{{json chartData}}};

      /* ===== BAR ===== */
       /* new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: chartData,
        options: {
          responsive: false,
          animation: false,
          scales: {
            y: {
              beginAtZero: true,
              max: 100
            }
          }
        }
      }); */

      /* ===== PIE ===== */
      /* new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.datasets[0].data,
            backgroundColor: [
              '#1890ff',
              '#52c41a',
              '#faad14',
              '#f5222d',
              '#722ed1'
            ]
          }]
        },
        options: {
          responsive: false,
          animation: false
        }
      }); */

      // OBJETIVOS BAR HORIZONTAL
      const objetivosChart = {{{json objetivosChart}}};
      new Chart(document.getElementById('objetivosComparacionChart'), {
        type: 'bar',
        data: objetivosChart,
        options: {
          indexAxis: 'y',
          responsive: false,
          animation: false,

          scales: {
            x: {
              beginAtZero: true,
              max: 120
            }
          },

          plugins: {
            legend: {
              position: 'right'
            }
          },

          datasets: {
            bar: {
              barThickness: 18
            }
          }
        }
      });


      // COMPETENCIAS DOUGHNUT
      const doughnutData = {{{json competenciasDoughnutChart}}};
      const centerTextPlugin = {
        id: 'centerText',
        beforeDraw(chart) {
          const { width } = chart;
          const { height } = chart;
          const ctx = chart.ctx;

          ctx.restore();

          const fontSize = (height / 5).toFixed(2);
          ctx.font = fontSize + "px Arial";
          ctx.textBaseline = "middle";
          ctx.fillStyle = "#2f80ed";

          const text = doughnutData.porcentaje + "%";
          const textX = Math.round((width - ctx.measureText(text).width) / 2);
          const textY = height / 2;

          ctx.fillText(text, textX, textY);
          ctx.save();
        }
      };
      new Chart(document.getElementById('doughnutChart'), {
        type: 'doughnut',
        data: {
          labels: ['Resultado Competencias', 'Pendiente'],
          datasets: [{
            data: [
              doughnutData.porcentaje,
              doughnutData.restante
            ],
            backgroundColor: [
              '#2f80ed',
              '#e5e5e5'
            ],
            borderWidth: 0
          }]
        },
        options: {
          responsive: false,
          cutout: '90%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                font: {
                  size: 12
                }
              }
            }
          }
        },
        plugins: [centerTextPlugin]
      });


      // COMPETENCIAS RADAR
      const radarData = {{{json competenciasRadarChart}}};
      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: radarData,
        options: {
          responsive: false,
          animation: false,

          plugins: {
            legend: {
              position: 'bottom', // 👈 leyenda abajo
              labels: {
                font: {
                  size: 12
                },
                boxWidth: 15
              }
            }
          },

          elements: {
            line: {
              borderWidth: 2
            },
            point: {
              radius: 4,
              hoverRadius: 6
            }
          },

          scales: {
            r: {
              beginAtZero: true,
              max: 100,
              ticks: {
                stepSize: 25,
                backdropColor: 'transparent',
                font: {
                  size: 10
                }
              },

              grid: {
                color: '#e8e8e8'
              },

              angleLines: {
                color: '#d9d9d9'
              },

              pointLabels: {
                font: {
                  size: 8,
                  // weight: 'bold',
                },
                color: '#333',
                // display: false
              }
            }
          }
        }
      });

      // EVALUACION FINAL DOUGHNUT
      const porcentajeFinal = {{{resultados.evaluacionFinal}}};
      const restanteFinal = 100 - porcentajeFinal;
      const centerTextFinal = {
        id: 'centerTextFinal',
        beforeDraw(chart) {

          const { width, height } = chart;
          const ctx = chart.ctx;

          ctx.restore();

          const fontSize = (height / 5).toFixed(2);
          ctx.font = fontSize + "px Arial";
          ctx.textBaseline = "middle";
          ctx.fillStyle = "#2f80ed";

          const text = porcentajeFinal + "%";

          const textX = Math.round((width - ctx.measureText(text).width) / 2);
          const textY = height / 2;

          ctx.fillText(text, textX, textY);
          ctx.save();
        }
      };
      new Chart(document.getElementById('evaluacionFinalChart'), {
        type: 'doughnut',

        data: {
          labels: ['Resultado ED', 'Pendiente'],
          datasets: [{
            data: [
              porcentajeFinal,
              restanteFinal
            ],
            backgroundColor: [
              '#2f80ed',
              '#e5e5e5'
            ],
            borderWidth: 0
          }]
        },

        options: {
          responsive: false,
          cutout: '85%',

          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                font: {
                  size: 12
                }
              }
            }
          }
        },

        plugins: [centerTextFinal]
      });
    </script>
