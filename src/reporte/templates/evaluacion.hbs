    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    {{#unless sinEvaluar}}
    <script>
      const chartData = {{{json chartData}}};

      /* ===== BAR ===== */
       /* new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: chartData,
        options: {
          responsive: false,
          animation: false,
          scales: {
            y: {
              beginAtZero: true,
              max: 100
            }
          }
        }
      }); */

      /* ===== PIE ===== */
      /* new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.datasets[0].data,
            backgroundColor: [
              '#1890ff',
              '#52c41a',
              '#faad14',
              '#f5222d',
              '#722ed1'
            ]
          }]
        },
        options: {
          responsive: false,
          animation: false
        }
      }); */

      // Tope de los ejes: se calcula desde los datos y nunca baja del 100.
      // Estaba fijo (120 en objetivos, 100 en competencias), así que un
      // objetivo superado al 166% y otro al 200% salían como la MISMA barra
      // llena hasta el borde y sin su etiqueta, contradiciendo a la tabla de
      // encima. Se redondea al múltiplo de 25 de arriba para que las marcas
      // del eje sigan siendo números redondos.
      // `holgura` deja siempre un escalón libre por encima del valor más alto:
      // la barra de objetivos lleva su porcentaje escrito en la punta y, al
      // llegar justo al tope, la etiqueta se salía del lienzo y se cortaba.
      const topeEje = (valores, minimo, holgura) => {
        const mayor = Math.max(minimo, ...valores.filter(Number.isFinite));
        return holgura
          ? Math.floor(mayor / 25) * 25 + 25
          : Math.ceil(mayor / 25) * 25;
      };

      // OBJETIVOS BAR HORIZONTAL
      const objetivosChart = {{{json objetivosChart}}};
      const topeObjetivos = topeEje(
        objetivosChart.datasets.flatMap((d) => d.data),
        120,
        true,
      );
      new Chart(document.getElementById('objetivosComparacionChart'), {
        type: 'bar',

        data: objetivosChart,

        options: {
          indexAxis: 'y',

          responsive: false,
          animation: false,

          layout: {
            padding: 10
          },

          scales: {
            x: {
              beginAtZero: true,
              max: topeObjetivos,

              grid: {
                color: '#e8e8e8'
              },

              ticks: {
                font: {
                  size: 11
                },

                callback: function(value) {
                  return value + '%';
                }
              }
            },

            y: {
              grid: {
                display: false
              },

              ticks: {
                font: {
                  size: 11,
                  weight: 'bold'
                }
              }
            }
          },

          plugins: {

            legend: {
              position: 'top',

              labels: {
                boxWidth: 14,
                font: {
                  size: 12,
                  weight: 'bold'
                }
              }
            },

            tooltip: {
              callbacks: {
                label: function(ctx) {
                  return ctx.dataset.label + ': ' + ctx.raw + '%';
                }
              }
            },

            datalabels: {
              anchor: 'end',
              align: 'right',

              color: '#000',

              font: {
                weight: 'bold',
                size: 11
              },

              formatter: (value) => value + '%'
            }

          },

          datasets: {
            bar: {
              borderRadius: 0,
              borderWidth: 1,
              barThickness: 18
            }
          }
        },

        plugins: [ChartDataLabels]

      });

      // COMPETENCIAS RADAR
      const radarData = {{{json competenciasRadarChart}}};

      // El tope sí se calcula desde los datos: estaba fijo en 100 y una
      // competencia por encima del resultado esperado quedaba recortada justo
      // en el borde, indistinguible de una que diera exactamente 100.
      const topeCompetencias = topeEje(
        radarData.datasets.flatMap((d) => d.data),
        100,
      );

      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: radarData,
        options: {
          responsive: false,
          animation: false,

          plugins: {
            legend: {
              position: 'bottom', // 👈 leyenda abajo
              labels: {
                font: {
                  size: 12
                },
                boxWidth: 15
              }
            }
          },

          elements: {
            line: {
              borderWidth: 2
            },
            point: {
              radius: 4,
              hoverRadius: 6
            }
          },

          scales: {
            r: {
              beginAtZero: true,
              max: topeCompetencias,

              ticks: {
                stepSize: 25,
                backdropColor: 'transparent',
                font: {
                  size: 10
                }
              },

              grid: {
                color: '#e8e8e8'
              },

              angleLines: {
                color: '#d9d9d9'
              },

              pointLabels: {
                font: {
                  size: 8,
                  weight: 'bold',
                },
                color: '#333',
              }
            }
          }
        }
      });

      // EVALUACION FINAL DOUGHNUT
      const porcentajeFinal = {{{resultados.evaluacionFinal}}};
// El resultado puede pasar de 100 (un objetivo superado da más del 100%), y
// entonces el "pendiente" salía negativo y Chart.js dibujaba el anillo roto.
// Se acota solo la geometría: la cifra del centro sigue siendo la real.
const restanteFinal = Math.max(0, 100 - porcentajeFinal);

const centerTextFinal = {
  id: 'centerTextFinal',
  beforeDraw(chart) {
    const { ctx, chartArea } = chart;

    if (!chartArea) return;

    const { left, right, top, bottom } = chartArea;

    const width = right - left;
    const height = bottom - top;

    ctx.save();

    const fontSize = Math.min(width, height) / 6;
    ctx.font = `${fontSize}px Arial`;
    ctx.fillStyle = "#2f80ed";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    const text = porcentajeFinal + "%";

    const centerX = left + width / 2;
    const centerY = top + height / 2;

    ctx.fillText(text, centerX, centerY);

    ctx.restore();
  }
};

new Chart(document.getElementById('evaluacionFinalChart'), {
  type: 'doughnut',

  data: {
    labels: ['Resultado ED', 'Pendiente'],
    datasets: [{
      data: [porcentajeFinal, restanteFinal],
      backgroundColor: [
        '#2f80ed',
        '#e5e5e5'
      ],
      borderWidth: 0
    }]
  },

  options: {
    responsive: false,
    cutout: '90%',

    plugins: {
      legend: {
        position: 'bottom',
        labels: {
          font: {
