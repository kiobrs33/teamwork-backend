                {{resultadosTexto.evaluacionFinal}}
              </td>
            </tr>
            <tr>
              <td class="table__cell table__cell--center table__cell--bold">
                Objetivos
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{empresa.pesoObjetivos}}%
              </td>
              <td class="table__cell table__cell--center table__cell--bold">
                {{resultadosTexto.objetivos}}
              </td>
            </tr>
          </tbody>
        </table>
