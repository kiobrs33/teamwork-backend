# ============================================================
#  .env.deploy.example — plantilla del entorno del VPS
# ============================================================
# Es el archivo que pide `docker-compose.yml` (`env_file: .env.deploy`).
#
# NO se sube a git: se crea a mano EN EL SERVIDOR, al lado del
# docker-compose.yml. Esta plantilla sí está versionada, para saber qué hace
# falta sin tener que entrar al VPS a mirarlo.
#
#   scp .env.deploy usuario@vps:/ruta/del/proyecto/.env.deploy
#   # o directamente: nano .env.deploy en el servidor
#
# Docker lo inyecta como variables del contenedor, y en Nest lo que viene por
# ahí GANA sobre cualquier archivo `.env*` que hubiera quedado dentro de la
# imagen. Por eso no hace falta un `.env.production`.
# ============================================================

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# OJO: el host es `db`, el nombre del servicio en docker-compose, y el puerto
# es el INTERNO (5432). El 5050 del compose es solo el puerto publicado hacia
# afuera del VPS; entre contenedores no se usa.
# Usuario, clave y BD tienen que coincidir con el bloque `db` del compose.
DATABASE_URL=postgresql://teamworkuser:teamworkpass@db:5432/teamworkdb?schema=public

# ------------------------------------------------------------
# Puerto
# ------------------------------------------------------------
# ⚠️ Tiene que coincidir con el lado derecho de `ports:` en el compose.
# Hoy el compose publica "3050:3000", así que acá va 3000. Si lo cambiás a
# 4055 (el mismo que en local), actualizá el compose a "3050:4055" y el
# EXPOSE del Dockerfile. Si esta variable falta, la aplicación usa 4055 por
# defecto y el mapeo del compose deja de apuntar a ningún lado.
PORT=3000

# ------------------------------------------------------------
# Autenticación
# ------------------------------------------------------------
# REQUERIDA. Distinta a la de desarrollo. Sin esto el contenedor no arranca.
JWT_SECRET_KEY=
JWT_EXPIRATION=7d

# ------------------------------------------------------------
# Cloudinary
# ------------------------------------------------------------
# Sin esto el backend arranca igual y solo falla la subida del logo de empresa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
